# Backend (FastAPI) environment configuration.
# Copy this file to `backend/.env` and fill in real values before running the
# backend (venv or docker-compose). Config is env-only -- no admin/config UI
# (FR-BE-9, NFR-8). Missing required vars cause the backend to fail fast at
# startup (except LangSmith, which degrades gracefully -- FR-OBS-2).
#
# NOTE ON LOCAL DEV DEFAULTS: the SUPABASE_* values below are the well-known
# Supabase *local development* demo secrets used by this project's
# docker-compose.yml (same demo JWTs published in Supabase's own self-hosting
# docs / used by `supabase start`). They work out of the box against the
# local docker-compose Supabase stack. Replace all four with your real
# Supabase project's values if you point this backend at a cloud project
# instead.

# ============================================================================
# Required
# ============================================================================

# Supabase project/API URL. For docker-compose, docker-compose.yml overrides
# this to http://kong:8000 for the backend container; this value (matching
# the host-published Kong port) is what you'd use running the backend
# directly via a venv against the local docker-compose Supabase stack.
SUPABASE_URL=http://localhost:54321

# Supabase anon key (JWT verification / request-scoped client). Local dev
# demo value -- see note above.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Supabase service-role key. Used ONLY for the Storage-delete and Realtime
# status-write paths -- never for normal per-user reads/writes (those go
# through the request-scoped client using the caller's JWT so RLS applies).
# Local dev demo value -- see note above.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Secret used to verify incoming Supabase JWTs (HS256). Local dev demo value
# -- see note above.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Vector dimension for chunk.embedding; MUST match the literal vector(N) in
# backend/supabase/migrations (currently vector(1536)). Default matches
# text-embedding-3-small. Changing providers to a different embedding
# dimension requires a new migration (altering the column + rebuilding
# chunk_embedding_idx) -- it is NOT sufficient to just change this value.
EMBEDDING_DIM=1536

# ============================================================================
# Module 1 -- OpenAI Responses API path (built at G-5a, then replaced by the
# Module 2 Chat Completions path per DD-1 = Replace; see design.md)
# ============================================================================

OPENAI_API_KEY=

# ============================================================================
# Module 2 -- OpenAI-compatible Chat Completions + embeddings (any
# OpenAI-compatible provider: OpenAI, OpenRouter, Ollama, LM Studio, etc.)
# ============================================================================

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# May equal LLM_BASE_URL if using the same provider for chat + embeddings.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# Optional -- tunables (defaults shown)
# ============================================================================

RETRIEVAL_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_BYTES=5242880

# ============================================================================
# Optional -- LangSmith observability (absence disables tracing; chat still
# works -- FR-OBS-2)
# ============================================================================

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false
