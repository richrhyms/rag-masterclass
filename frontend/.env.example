# Frontend (Vite) environment configuration. All vars are VITE_-prefixed and
# therefore public (bundled into the browser build) -- do not put secrets
# here beyond the anon key, which is designed to be public.
#
# Copy this file to `frontend/.env` before running the frontend (docker-compose
# or `npm run dev`).
#
# NOTE ON LOCAL DEV DEFAULTS: VITE_SUPABASE_* below are the well-known
# Supabase *local development* demo values used by this project's
# docker-compose.yml. They work out of the box against the local
# docker-compose Supabase stack. Replace with your real Supabase project's
# values if you point this frontend at a cloud project instead.

# ============================================================================
# Required
# ============================================================================

# Supabase URL for auth + Realtime, as reachable from the browser (the
# host-published Kong gateway port, not an internal docker service name).
VITE_SUPABASE_URL=http://localhost:54321

# Supabase anon key for the browser Supabase client. Local dev demo value --
# see note above.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# FastAPI base URL the frontend calls.
#
# BASE-URL CONVENTION (see also the comment block at the top of
# `frontend/src/lib/apiClient.ts`): this must be the backend ORIGIN ONLY --
# no trailing `/api`. The frontend code appends `/api/<path>` itself exactly
# once, so setting this to a value that already ends in `/api` will produce a
# broken double-prefixed `/api/api/...` URL.
#
# Local dev (recommended): leave this EMPTY. `npm run dev` binds the Vite
# dev server to :3000, which proxies `/api` -> http://localhost:8000 (see
# `vite.config.ts`), so requests from the browser go to the same origin
# (localhost:3000) and never need an absolute backend URL.
#
# Production / any build that is NOT served through the Vite dev proxy: set
# this to the backend's origin, e.g. `https://api.example.com` (still no
# trailing `/api`).
VITE_API_BASE_URL=
